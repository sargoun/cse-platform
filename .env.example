# ===========================================================================
# CSE-Plattform — die Umgebungsvariablen, vollständig
#
# Kopieren nach `.env.local` (die Datei steht in `.gitignore` und gehört
# NIE ins Repository). Jede Zeile hier wird irgendwo im Code wirklich
# gelesen — geprüft mit:
#     grep -rhoP "process\.env\[['\"]\K[A-Z0-9_]+" src/ scripts/ | sort -u
#
# Was fehlt, schaltet eine Funktion AB. Nichts wird simuliert (CLAUDE.md,
# „No fake integrations"): ohne Schlüssel sagt die Oberfläche „nicht
# verbunden", und der Rest der Anwendung läuft weiter.
#
# Den wahren Zustand zeigt die Plattform selbst:
#     /portal/<gesellschaft>/einstellungen/integrationen
# ===========================================================================

# --- 1. PFLICHT: ohne diese startet nichts ---------------------------------

# Postgres. Lokal über Docker (siehe docs/LOKAL-STARTEN.md).
DATABASE_URL=postgres://postgres@localhost:5433/postgres

# Der Hafen der Anwendung.
PORT=3001


# --- 2. DEMO-BETRIEB -------------------------------------------------------

# `1` schaltet die Demoflächen frei: Demodaten, der SMS-Code steht auf dem
# Bildschirm statt im Netz, Kekse ohne `Secure`, /dev/anmelden.
# IN PRODUKTION LEER LASSEN. Ein `1` hier heisst: jeder kann sich als jeder
# anmelden.
CSE_DEV_FLAECHEN=1


# --- 3. SUPABASE (Speicher + Anmeldung) ------------------------------------
# EU-Region Frankfurt, Pflicht — die Plattform hält Zeit-, Gesundheits- und
# Finanzdaten dreier deutscher Rechtseinheiten.
#
# Woher: Supabase → Project Settings → API.
# Der Service-Role-Key ist ein VOLLZUGRIFF. Er steht nur hier, nie im
# Browser, nie in einem Commit.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NUR für einen Vorführrechner (V-131, D-623): ohne Supabase legt die
# Plattform Dateien in diesen Ordner. Greift nur mit CSE_DEV_FLAECHEN=1 (oder
# `pnpm dev`), nie auf Vercel, und nie, wenn SUPABASE_URL gesetzt ist.
# Leer lassen in jeder echten Installation.
CSE_SPEICHER_ORDNER=


# --- 4. SPRACHMODELL (OpenAI) ----------------------------------------------
# VIER Tore, und alle vier müssen offen sein. Fällt eines, sagt die
# Oberfläche „KI-Funktion nicht verfügbar" und die Arbeit läuft von Hand
# weiter. Es gibt KEINE stille Ausweichroute.
#
#   Tor 1  CSE_KI_MODELL darf NICHT `nicht_verbunden` sein
#   Tor 2  OPENAI_API_KEY muss gesetzt sein
#   Tor 3  OPENAI_DATA_RESIDENCY muss `eu` sein
#   Tor 4  OPENAI_BASE_URL muss https sein, ohne Zugangsdaten, ohne Query,
#          und der Wirt muss in der erlaubten Liste stehen
#
# UND: eine Zeile in der Tabelle `modell_register` muss EU-Verarbeitung,
# Nullspeicherung und Freigabe bezeugen. Siehe docs/EINRICHTEN-DE.md §4.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_DATA_RESIDENCY=eu

# Weitere EU-Endpunkte, kommagetrennt. NUR setzen, wenn der
# Auftragsverarbeitungsvertrag sie deckt (O-509). Leer = nur eu.api.openai.com.
OPENAI_EU_HOSTS=

# Der Riegel für Abnahmeumgebungen: `nicht_verbunden` gewinnt gegen
# Schlüssel und Registerzeile. Eine Umgebung, die nicht hinausrufen soll,
# ruft nicht hinaus.
CSE_KI_MODELL=nicht_verbunden


# --- 5. NACHTLÄUFE ---------------------------------------------------------
# Das gemeinsame Geheimnis zwischen Supabase-cron und der Plattform.
# Erzeugen: openssl rand -base64 32
# Gesetzt heisst „die Tür ist offen", nicht „jemand hat angeklopft" —
# bestätigt wird durch Aktivität in /einstellungen/jobs.
JOB_TOKEN=


# --- 6. WETTER (DWD OpenData) ----------------------------------------------
# Für die Bauwetter-Dokumentation nach VOB/B. Kostenlos, keine Anmeldung.
# Leer = nicht verbunden; das Bautagebuch bleibt ohne Wetterzeile.
DWD_OPENDATA_BASE=


# --- 7. SICHERHEIT ---------------------------------------------------------

# Pfeffer für die IP-Hashes in den öffentlichen Formularen (Honigtopf,
# Ratenlimit). Erzeugen: openssl rand -hex 32
# Ohne ihn sind die Hashes ungesalzen und damit rückrechenbar.
CSE_IP_PFEFFER=

# Erlaubte Ursprünge für Formular-POSTs, kommagetrennt.
# Leer = nur der eigene Ursprung.
CSE_VERTRAUTE_URSPRUENGE=

# Die kanonische Basisadresse — steht in Links, die das Haus verlassen.
CSE_KANONISCHE_BASIS=https://www.cse-dienstleistungen.de

# Die Codeversion in der Verfahrensdokumentation (GoBD). Auf Vercel kommt
# sie von selbst aus VERCEL_GIT_COMMIT_SHA.
CSE_CODE_VERSION=


# --- 8. NUR FÜR TESTS ------------------------------------------------------
# Die Isolationssuite legt sich ihre Datenbanken selbst an (Port 55432).
TEST_DATABASE_URL=


# ===========================================================================
# NICHT VERBUNDEN, UND ES GIBT KEINE VARIABLE DAFÜR
#
# Diese Anbindungen sind als Schnittstelle gebaut und warten auf eine
# ENTSCHEIDUNG, nicht auf einen Schlüssel. Sie stehen in
# docs/DECISIONS.md unter „Offen":
#
#   E-Mail-Versand       O-36    welcher EU-Anbieter, unter welchem AV-Vertrag?
#   SMS-Gateway          O-82    welches EU-gehostete Gateway?
#   Belegerkennung OCR   O-135   welcher Anbieter?
#   Karten/Geokodierung  O-132   welcher EU-gehostete Kartendienst?
#   n8n                  O-123   eigene Instanz oder Cloud?
#   LinkedIn, Instagram  —       Konten und App-Registrierung fehlen
#   Jobbörsen            —       Recruiting läuft über EINGEHENDE Bewerbungen
#
#   DATEV                        KEINE Variable, und das ist die Entscheidung:
#                                der Steuerberater bekommt eine DATEI (D-06).
#   Vergabeplattformen           Es gibt keine API. Einreichung ist von Hand
#                                gewollt.
# ===========================================================================
